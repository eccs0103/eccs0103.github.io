{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "telegram-proxy",
	"main": "controllers/media-proxy-worker.ts",
	"compatibility_date": "2026-03-11",
	"upload_source_maps": true,
	"routes": [
		{ "pattern": "telegram-proxy.eccs.dev", "custom_domain": true }
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"vars": {
		"TELEGRAM_CHANNEL_ID": "-1003471238866",
		"TELEGRAM_CHANNEL_ID_DEVELOPMENT": "-1003772930485"
	},
	"secrets": {
		"required": ["TELEGRAM_API_ID", "TELEGRAM_API_HASH", "TELEGRAM_SESSION"]
	}
}
